<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="2dp"
        android:paddingTop="5dp"
        android:paddingRight="2dp"
        android:paddingBottom="5dp">

        <!-- Mini Credit Card Graphic Swatch (Clean, no artifacts, symmetrically rounded) -->
        <ImageView
            android:id="@+id/widget_card_image"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:scaleType="fitCenter" />

        <!-- Card Name & Network Subtitle (No card digits under title) -->
        <LinearLayout
            android:id="@+id/widget_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="9dp"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/widget_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Card Name"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Visa"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Urgency Countdown & Status Badge (Vertical Stack exactly matching in-app card tile) -->
        <LinearLayout
            android:id="@+id/widget_status_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="end|right"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|right"
                android:gravity="end|right"
                android:includeFontPadding="false"
                android:text="30d"
                android:textColor="@color/widget_status_safe_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|right"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_badge_safe"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="8dp"
                android:paddingTop="3dp"
                android:paddingRight="8dp"
                android:paddingBottom="3dp"
                android:text="SAFE"
                android:textColor="@color/widget_status_safe_text"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hairline row divider matching in-app card list -->
    <FrameLayout
        android:id="@+id/widget_item_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider" />
</LinearLayout>
